@page "/"
@inject HttpClient Http
@inject NavigationManager NavigationManager

<PageTitle>Piedra, Papel o Tijera</PageTitle>

<h1>Piedra, Papel o Tijera Games</h1>
<p>Por favor registre los jugadores</p>
<div>
    <label>Jugador 1</label>
    <input @bind="player1" placeholder="Nombre Completo" />
</div>
<div>
    <label>Jugador 2</label>
    <input @bind="player2" placeholder="Nombre Completo" />
</div>
<button @onclick="StartGame">Iniciar Batalla</button>

@code {
    string player1 = "";
    string player2 = "";
    async Task StartGame()
    {
        var req = new { Player1Name = player1, Player2Name = player2 };
        var res = await Http.PostAsJsonAsync("api/games/start", req);
        if (res.IsSuccessStatusCode)
        {
            var data = await res.Content.ReadFromJsonAsync<StartGameResponse>();
            NavigationManager.NavigateTo($"/game/{data!.GameId}");
        }
    }
    class StartGameResponse { public System.Guid GameId { get; set; } public string Player1Name { get; set; } public string Player2Name { get; set; } }
}
